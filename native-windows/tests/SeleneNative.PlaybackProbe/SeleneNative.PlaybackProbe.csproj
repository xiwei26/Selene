<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless check of the real Windows media engine behind WindowsMediaPlayer and
    PlayerViewModel. It renders its own short clips, so it needs no network and no
    window. Not part of build.ps1; run it by hand (see native-windows/README.md).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SeleneNative.PlaybackProbe</RootNamespace>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <IsPackable>false</IsPackable>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The adapter under test is compiled in as-is from the app project. -->
    <Compile Include="..\..\src\SeleneNative\Services\WindowsMediaPlayer.cs" Link="WindowsMediaPlayer.cs" />
    <ProjectReference Include="..\..\src\SeleneNative.Core\SeleneNative.Core.csproj" />
  </ItemGroup>
</Project>
